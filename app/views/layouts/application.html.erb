<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:og_title) || "あそびログ" %></title>                                            
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <meta property="og:title" content="<%= content_for(:og_title) || "あそびログ" %>">
    <meta property="og:description" content="<%= content_for(:og_description) || "あそび場さがし＆記録アプリ" %>">
    <meta property="og:image" content="<%= content_for(:og_image) || image_url("ogp_default.png") %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="あそびログ">
    <meta name="twitter:card" content="summary_large_image">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Mochiy+Pop+One&family=M+PLUS+Rounded+1c:wght@400;500;700&display=swap">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav>
      <%= link_to "あそびログ", root_path %>
      <% if logged_in? %>
        <span><%= current_user.nickname %>さん</span>
        <%= link_to "マイページ", mypage_path %>
        <%= link_to "お気に入り一覧", favorites_path %>
        <%= link_to "行った場所一覧", visits_path %>
        <% if current_user.admin? %>
          <%= link_to "管理画面", admin_deletion_requests_path %>
        <% end %>
        <%= button_to "ログアウト", session_path, method: :delete %>
      <% else %>
        <%= link_to "ログイン", new_session_path %>
        <%= link_to "新規登録", new_user_path %>
      <% end %>
    </nav>

    <% if notice %>
      <p class="notice"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="alert"><%= alert %></p>
    <% end %>
    
    <%= yield %>
  </body>
</html>
