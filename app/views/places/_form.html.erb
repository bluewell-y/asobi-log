<%= form_with model: @place, multipart: true do |f| %>
  <% if @place.errors.any? %>
    <div>
      <ul>
        <% error_messages_in_form_order(@place, %i[name cover_image sub_images address category indoor_outdoor min_age max_age adult_price child_price opening_time closing_time description]).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name do %>遊び場名 <span class="required">*必須</span><% end %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :cover_image do %>トップ画像 <span class="required">*必須</span><% end %>
    <%= f.file_field :cover_image, accept: "image/*" %>
  </div>

  <div>
    <%= f.label :sub_images, "参考画像（複数可）" %>
    <%= f.file_field :sub_images, multiple: true, accept: "image/*", data: { image_preview_target: "input", action: "change->image-preview#update" } %>
  </div>

  <div>
    <%= f.label :address do %>住所 <span class="required">*必須</span><% end %>
    <%= f.text_field :address %>
  </div>

  <div>
    <%= f.label :category do %>カテゴリ <span class="required">*必須</span><% end %>
    <%= f.select :category, [["公園", "park"], ["室内施設", "indoor_facility"], ["博物館・科学館", "museum"], ["水族館・動物園", "aquarium_zoo"], ["その他", "other"]], include_blank: "選択してください" %>
  </div>

  <div>
    <%= f.label :indoor_outdoor do %>屋内/屋外 <span class="required">*必須</span><% end %>
    <%= f.select :indoor_outdoor, [["屋内", "indoor"], ["屋外", "outdoor"], ["両方", "both"]], include_blank: "選択してください" %>
  </div>

  <div>
    <%= f.label :min_age, "対象年齢（何歳から）" %>
    <%= f.select :min_age, (0..15).to_a, { include_blank: true } %>
  </div>

  <div>
    <%= f.label :max_age, "対象年齢（何歳まで）" %>
    <%= f.select :max_age, (0..15).to_a, { include_blank: "年齢上限なし" } %>
  </div> 

  <div>
    <%= f.label :adult_price, "大人料金" %>                           
    <%= f.number_field :adult_price %> 円                                                                
  </div>

  <div>
    <%= f.label :child_price, "子供料金" %>
    <%= f.number_field :child_price %> 円                             
  </div> 

  <div>
    <%= f.label :opening_time, "営業時間（開始）" %>
    <%= f.text_field :opening_time, list: "time_options" %>
  </div>                                                              
                                                                                                          
  <div>
    <%= f.label :closing_time, "営業時間（終了）" %>
    <%= f.text_field :closing_time, list: "time_options" %>
  </div>

  <datalist id="time_options">
    <% %w[7:00 8:00 8:30 9:00 9:30 10:00 10:30 11:00 11:30 12:00 12:30 13:00 13:30 14:00 14:30 15:00 15:30 16:00 16:30 17:00 17:30 18:00 19:00 20:00 21:00 22:00].each do |t| %>
      <option value="<%= t %>"></option>
    <% end %>
  </datalist>

  <div>
    <%= f.label :description, "説明" %>
    <%= f.text_area :description %>
  </div>

  <%= f.submit "保存する" %>
<% end %>