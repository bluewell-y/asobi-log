<div data-controller="image-preview">
  <h1>遊び場を編集</h1>

  <% if @place.cover_image.attached? %>
    <h2>現在のトップ画像</h2>
    <%= image_tag @place.cover_image.variant(resize_to_fill: [200, 120]) %>
    <p>変更する場合は、下のフォームで新しい画像を選んでください。</p>
  <% end %>

  <h2>現在の参考画像</h2>
  <div class="place-gallery" data-image-preview-target="gallery">
    <% @place.sub_images.each do |sub_image| %>
      <div class="sub-image-item">
        <%= image_tag sub_image.variant(resize_to_fill: [90, 90]) %>
        <%= button_to "×", remove_sub_image_path(@place, sub_image.id),
              method: :delete,
              form_class: "sub-image-delete",
              class: "sub-image-delete-btn",
              data: { turbo_confirm: "この画像を削除しますか？" } %>
      </div>
    <% end %>
  </div>

  <%= render "form" %>
</div>