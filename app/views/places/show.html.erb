<h1><%= @place.name %></h1>

<div data-controller="lightbox">
  <% if @place.cover_image.attached? %>
    <%= image_tag @place.cover_image.variant(resize_to_fill: [480, 260]),
          class: "place-cover-image",
          role: "button",
          data: { action: "click->lightbox#open",
                  lightbox_full: url_for(@place.cover_image.variant(resize_to_limit: [1200, 1200])) } %>
  <% end %>       
  
  <% if @place.sub_images.attached? %>
    <div class="place-gallery">
      <% @place.sub_images.each do |sub_image| %>
        <%= image_tag sub_image.variant(resize_to_fill: [90, 90]),
              class: "place-gallery-img",
              role: "button",
              data: { action: "click->lightbox#open",
                      lightbox_full: url_for(sub_image.variant(resize_to_limit: [1200, 1200])) } %>
      <% end %>       
    </div>
  <% end %>
  
  <dialog data-lightbox-target="dialog"
          data-action="click->lightbox#backdropClick keydown@window->lightbox#keydown touchstart->lightbox#touchStart touchend->lightbox#touchEnd"
          class="lightbox">
    <button type="button" class="lightbox-close" data-action="lightbox#dismiss" aria-label="閉じる">×</button>
    <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-target="prevButton" data-action="lightbox#prev" aria-label="前の画像">‹</button>
    <%= image_tag "", data: { lightbox_target: "image" }, class: "lightbox-img", alt: "" %>
    <button type="button" class="lightbox-nav lightbox-next" data-lightbox-target="nextButton" data-action="lightbox#next" aria-label="次の画像">›</button>
  </dialog>
</div>

<p>住所：<%= @place.address %></p>
<p>カテゴリ：<%= @place.category_label %></p>
<p>屋内/屋外：<%= @place.indoor_outdoor_label %></p>
<p>対象年齢：<%= @place.min_age %>歳〜<%= @place.max_age %>歳</p>
<p>料金：<%= @place.price %></p>
<p>営業時間：<%= @place.business_hours %></p>
<p>説明：<%= @place.description %></p>
<p>登録者：<%= @place.user.name %></p>

<% if logged_in? %>
  <% if current_user.favorites.exists?(place: @place) %>
    <%= button_to "お気に入り解除", place_favorite_path(@place), method: :delete %>
  <% else %>
    <%= button_to "お気に入りに追加", place_favorite_path(@place), method: :post %>
  <% end %>

  <% if current_user.visits.exists?(place: @place) %>
    <%= button_to "「行った」を解除", place_visit_path(@place), method: :delete %>
  <% else %>
    <%= button_to "行った！", place_visit_path(@place), method: :post %>
  <% end %>
<% end %>

<% if logged_in? && @place.user == current_user %>
  <%= link_to "編集する", edit_place_path(@place), class: "btn btn--owner" %>
  <%= button_to "削除する", place_path(@place), method: :delete, class: "btn--owner", data: { turbo_confirm: "本当に削除しますか？" } %>
<% end %>

<%= link_to "一覧に戻る", places_path, class: "btn" %>