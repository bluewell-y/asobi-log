<h1>プロフィール編集</h1>

<%= form_with model: @user, url: mypage_path, method: :patch do |f| %>
  <% if @user.errors.any? %>
    <div>
      <ul>
        <% error_messages_in_form_order(@user, %i[name nickname email password password_confirmation]).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name do %>名前 <span class="required">*必須</span><% end %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :nickname do %>ニックネーム <span class="required">*必須</span><% end %>
    <%= f.text_field :nickname %>
    <p class="field-hint">他の人と重複しない名前を入力してください。<br>遊び場の登録者名・口コミの投稿者名として表示されます。</p>
  </div>

  <div>
    <%= f.label :email do %>メールアドレス <span class="required">*必須</span><% end %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password, "新しいパスワード（変更する場合のみ入力）" %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "更新する" %>
<% end %>

<%= link_to "マイページに戻る", mypage_path %>

<hr>

<h2>退会</h2>
<p>退会すると、登録した遊び場・お気に入り・行った場所の記録もすべて削除されます。</p>
<%= button_to "退会する", mypage_path, method: :delete, data: { turbo_confirm: "本当に退会しますか？この操作は取り消せません。" } %>