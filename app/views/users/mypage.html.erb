<h1>マイページ</h1>

<%= link_to "プロフィールを編集する", edit_mypage_path %>

<h2>サマリー</h2>
<ul>
  <li>訪問履歴（<%= link_to "一覧を見る", visit_logs_path %>）</li>
  <li>投稿した口コミ（<%= link_to "一覧を見る", reviews_path %>）</li>
</ul>

<h2>自分が登録した遊び場 <span class="list-count">（<%= @places.count %>件）</span></h2>
<ul>
  <% @places.each do |place| %>
    <li><%= link_to place.name, place_path(place) %></li>
  <% end %>
</ul>