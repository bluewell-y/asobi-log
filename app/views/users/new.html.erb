<h1>新規登録</h1>

<%= form_with model: @user, url: users_path do |f| %>
  <% if @user.errors.any? %>
    <div>
      <ul>
        <% error_messages_in_form_order(@user, %i[last_name first_name last_name_kana first_name_kana nickname age_group gender children_count email password password_confirmation]).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="name-fields">
    <div>
      <%= f.label :last_name do %>姓 <span class="required">*必須</span><% end %>
      <%= f.text_field :last_name, placeholder: "山田" %>
    </div>
    <div>
      <%= f.label :first_name do %>名 <span class="required">*必須</span><% end %>
      <%= f.text_field :first_name, placeholder: "太郎" %>
    </div>
  </div>

  <div class="name-fields">
    <div>
      <%= f.label :last_name_kana do %>セイ <span class="required">*必須</span><% end %>
      <%= f.text_field :last_name_kana, placeholder: "ヤマダ" %>
      <p class="field-hint">全角カタカナで入力してください。</p>
    </div>
    <div>
      <%= f.label :first_name_kana do %>メイ <span class="required">*必須</span><% end %>
      <%= f.text_field :first_name_kana, placeholder: "タロウ" %>
    </div>
  </div>

  <div>
    <%= f.label :nickname do %>ニックネーム <span class="required">*必須</span><% end %>
    <%= f.text_field :nickname %>
    <p class="field-hint">他の人と重複しない名前を入力してください。<br>遊び場の登録者名・口コミの投稿者名として表示されます。</p>
  </div>

  <div>
    <%= f.label :age_group do %>年代 <span class="required">*必須</span><% end %>
    <%= f.select :age_group, User::AGE_GROUP_LABELS.invert, {include_blank: "選択してください"} %>
  </div>

  <div>
    <%= f.label :gender do %>性別 <span class="required">*必須</span><% end %>
    <%= f.select :gender, User::GENDER_LABELS.invert, {include_blank: "選択してください"} %>
  </div>

  <div>
    <%= f.label :children_count, "子どもの人数" %>
    <%= f.select :children_count, User.children_count_options, {include_blank: "選択してください"} %>
    <p class="field-hint">年代・性別・子どもの人数は、ユーザー公開ページに表示されます。</p>
  </div>

  <div>
    <%= f.label :email do %>メールアドレス <span class="required">*必須</span><% end %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password do %>パスワード <span class="required">*必須</span><% end %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation do %>パスワード（確認） <span class="required">*必須</span><% end %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "登録する" %>
<% end %>