<h1>新規登録</h1>

<%= form_with model: @user, url: users_path do |f| %>
  <% if @user.errors.any? %>
    <div>
      <ul>
        <% error_messages_in_form_order(@user, %i[name nickname email password password_confirmation]).each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name do %>名前 <span class="required">*必須</span><% end %>
    <%= f.text_field :name %>
  </div>
  <div>
    <%= f.label :nickname do %>ニックネーム <span class="required">*必須</span><% end %>
    <%= f.text_field :nickname %>
    <p class="field-hint">他の人と重複しない名前を入力してください。<br>遊び場の登録者名・口コミの投稿者名として表示されます。</p>
  </div>

  <div>
    <%= f.label :email do %>メールアドレス <span class="required">*必須</span><% end %>
    <%= f.email_field :email %>
  </div>

  <div>
    <%= f.label :password do %>パスワード <span class="required">*必須</span><% end %>
    <%= f.password_field :password %>
  </div>

  <div>
    <%= f.label :password_confirmation do %>パスワード（確認） <span class="required">*必須</span><% end %>
    <%= f.password_field :password_confirmation %>
  </div>

  <%= f.submit "登録する" %>
<% end %>